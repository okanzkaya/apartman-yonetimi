<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Elite Apartman Yönetim Sistemi</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

        :root {
            --primary: #4f46e5;
            --primary-hover: #4338ca;
            --bg-dark: #0f172a;
            --bg-light: #f8fafc;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --white: #ffffff;
            --border: #e2e8f0;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #3b82f6;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Plus Jakarta Sans', sans-serif; }
        body { background: var(--bg-light); color: var(--text-main); }

        #login-page {
            background: radial-gradient(circle at center, #1e293b, #0f172a);
            height: 100vh; display: flex; justify-content: center; align-items: center;
            position: fixed; width: 100%; z-index: 9999;
        }
        .login-card { 
            background: var(--white); padding: 48px; border-radius: 28px; width: 420px; 
            box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5); text-align: center;
        }
        .login-card h2 { font-size: 1.75rem; font-weight: 700; margin-bottom: 8px; }
        .login-card p { color: var(--text-muted); margin-bottom: 32px; font-size: 0.95rem; }

        .input-wrapper { text-align: left; margin-bottom: 20px; }
        .input-wrapper label { display: block; margin-bottom: 8px; font-size: 0.85rem; font-weight: 600; color: var(--text-main); }
        .input-wrapper input, .input-wrapper select, .input-wrapper textarea { 
            width: 100%; padding: 12px 16px; border: 1.5px solid var(--border); border-radius: 12px; 
            outline: none; transition: 0.3s; font-size: 0.95rem; color: var(--text-main); background: white;
        }
        .input-wrapper input:focus, .input-wrapper select:focus, .input-wrapper textarea:focus { border-color: var(--primary); }
        
        .btn-action { 
            padding: 12px 24px; border: none; border-radius: 12px; 
            cursor: pointer; font-weight: 700; background: var(--primary); color: white; 
            transition: 0.3s;
        }
        .btn-action:hover { background: var(--primary-hover); transform: translateY(-2px); }

        #admin-panel { display: none; min-height: 100vh; }
        .sidebar { 
            width: 280px; background: var(--bg-dark); color: white; padding: 32px 24px; 
            position: fixed; height: 100vh; overflow-y: auto;
        }
        .sidebar-brand { color: var(--primary); font-size: 1.4rem; font-weight: 800; margin-bottom: 40px; text-align: center; }
        .nav-menu { list-style: none; }
        .nav-item { 
            padding: 14px 18px; cursor: pointer; border-radius: 12px; color: #94a3b8; 
            margin-bottom: 8px; transition: 0.3s; font-weight: 500; display: flex; align-items: center; gap: 12px;
        }
        .nav-item:hover, .nav-item.active { background: #1e293b; color: white; }
        .nav-item.active { background: var(--primary); color: white; }

        .main-view { flex: 1; margin-left: 280px; padding: 40px; }
        
        header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; }
        header h1 { font-size: 1.8rem; font-weight: 700; }

        .user-profile { position: relative; display: flex; align-items: center; gap: 12px; cursor: pointer; padding: 8px 16px; border-radius: 15px; background: white; border: 1.5px solid var(--border); }
        .user-avatar { width: 35px; height: 35px; background: var(--primary); color: white; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-weight: bold; }
        .user-menu { position: absolute; top: 110%; right: 0; width: 180px; background: white; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); border: 1px solid var(--border); display: none; z-index: 100; }
        .user-menu.active { display: block; }
        .menu-item { padding: 12px 16px; font-size: 0.9rem; color: var(--text-main); transition: 0.2s; }
        .menu-item:hover { background: #f8fafc; color: var(--danger); }

        .view-section { display: none; }
        .view-section.active { display: block; animation: slideUp 0.3s ease; }
        @keyframes slideUp { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }

        .data-card { background: white; padding: 24px; border-radius: 20px; border: 1.5px solid var(--border); margin-bottom: 24px; }
        table { width: 100%; border-collapse: collapse; }
        table th { padding: 14px; text-align: left; color: var(--text-muted); font-size: 0.7rem; text-transform: uppercase; border-bottom: 1.5px solid #f1f5f9; }
        table td { padding: 14px; border-bottom: 1px solid #f1f5f9; font-size: 0.9rem; }
        
        .badge { padding: 5px 10px; border-radius: 8px; font-size: 0.7rem; font-weight: 700; }
        .success { background: #dcfce7; color: #166534; }
        .danger { background: #fee2e2; color: #991b1b; }
        .warning { background: #fef3c7; color: #92400e; }
        .info { background: #e0f2fe; color: #0369a1; }
    </style>
</head>
<body>

    <div id="login-page">
        <div class="login-card">
            <h2>Elite Yönetim</h2>
            <p>API Rehberine Uygun Giriş Paneli</p>
            <div class="input-wrapper">
                <label>E-posta</label>
                <input type="email" id="emailField" placeholder="ahmet@gmail.com">
            </div>
            <div class="input-wrapper">
                <label>Şifre</label>
                <input type="password" id="passField" placeholder="****">
            </div>
            <button class="btn-action" style="width:100%" onclick="core.authenticate()">Oturum Aç</button>
        </div>
    </div>

    <div id="admin-panel">
        <aside class="sidebar">
            <div class="sidebar-brand">ELİTE YÖNETİM</div>
            <ul class="nav-menu">
                <li class="nav-item active" onclick="core.switchTab('duyurular', this)">📢 Duyurular</li>
                <li class="nav-item" onclick="core.switchTab('aidatlar', this)">💰 Aidat Sorgula</li>
                <li class="nav-item" onclick="core.switchTab('arizalar', this)">🛠️ Arıza Sistemi</li>
            </ul>
        </aside>

        <main class="main-view">
            <header>
                <h1 id="view-title">Duyurular</h1>
                <div class="user-profile" onclick="core.toggleUserMenu()">
                    <div class="user-avatar" id="userInitial">U</div>
                    <span id="userNameDisplay" style="font-weight: 600; font-size: 0.9rem;">Kullanıcı</span>
                    <div class="user-menu" id="userMenu">
                        <div class="menu-item" onclick="core.logout()">🔒 Çıkış Yap</div>
                    </div>
                </div>
            </header>

            <section id="duyurular" class="view-section active">
                <div class="data-card">
                    <h3>📢 Yeni Duyuru Yayınla (Yönetici)</h3>
                    <br>
                    <div style="display:grid; grid-template-columns: 1fr 3fr auto; gap:15px; align-items:flex-end">
                        <div class="input-wrapper" style="margin:0"><label>Apartman ID</label><input type="number" id="apDuyuruId" value="1"></div>
                        <div class="input-wrapper" style="margin:0"><label>Duyuru İçeriği</label><input type="text" id="txtDuyuru" placeholder="Duyuru metnini yazın..."></div>
                        <button class="btn-action" onclick="core.saveDuyuru()">Yayınla</button>
                    </div>
                </div>
                <div class="data-card">
                    <button class="btn-action" style="margin-bottom:15px; background:#64748b" onclick="core.fetchDuyurular()">Duyuruları Güncelle (ID: 1)</button>
                    <table>
                        <thead><tr><th>Apartman ID</th><th>Duyuru İçeriği</th></tr></thead>
                        <tbody id="duyuru-table"></tbody>
                    </table>
                </div>
            </section>

            <section id="aidatlar" class="view-section">
                <div class="data-card">
                    <div style="display: flex; gap: 20px; align-items: center; justify-content: space-between;">
                        <div>
                            <h3>💰 Aidat ve Borç Sorgulama</h3>
                            <p>Daire ID'ye göre borçları listeler.</p>
                        </div>
                        <button class="btn-action" style="background:var(--success)" onclick="core.calculateAidat()">Toplu Aidat Hesapla (Prosedür)</button>
                    </div>
                    <br>
                    <div style="display: flex; gap: 10px;">
                        <input type="number" id="daireIdSorgu" style="padding:10px; border-radius:8px; border:1px solid #ddd" placeholder="Daire ID (Örn: 1)">
                        <button class="btn-action" onclick="core.fetchAidat()">Sorgula</button>
                    </div>
                </div>
                <div class="data-card">
                    <table>
                        <thead><tr><th>Daire ID</th><th>Borç Tutarı</th><th>Durum</th></tr></thead>
                        <tbody id="aidat-table"></tbody>
                    </table>
                </div>
            </section>

            <section id="arizalar" class="view-section">
                <div class="data-card">
                    <h3>🛠️ Yeni Arıza Bildir</h3>
                    <br>
                    <div style="display:grid; grid-template-columns: 1fr 3fr auto; gap:15px; align-items:flex-end">
                        <div class="input-wrapper" style="margin:0"><label>Daire ID</label><input type="number" id="daireArizaId" placeholder="1"></div>
                        <div class="input-wrapper" style="margin:0"><label>Arıza Açıklaması</label><input type="text" id="txtAriza" placeholder="Sorunu açıklayın..."></div>
                        <button class="btn-action" onclick="core.saveAriza()">Bildir</button>
                    </div>
                </div>
                <div class="data-card">
                    <button class="btn-action" style="margin-bottom:15px; background:#64748b" onclick="core.fetchArizalar()">Tüm Arızaları Listele</button>
                    <table>
                        <thead><tr><th>Daire ID</th><th>Açıklama</th></tr></thead>
                        <tbody id="issue-table"></tbody>
                    </table>
                </div>
            </section>
        </main>
    </div>

    <script>
        const API_BASE = "http://localhost:5000/api";

        const core = {
            // 1. GİRİŞ İŞLEMİ (Auth)
            authenticate: async () => {
                const email = document.getElementById('emailField').value;
                const sifre = document.getElementById('passField').value;

                try {
                    const res = await fetch(`${API_BASE}/auth/login`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ email, sifre })
                    });
                    const data = await res.json();

                    if(res.ok) {
                        document.getElementById('login-page').style.display = 'none';
                        document.getElementById('admin-panel').style.display = 'flex';
                        document.getElementById('userNameDisplay').innerText = data.ad || 'Kullanıcı';
                        document.getElementById('userInitial').innerText = (data.ad || 'U')[0].toUpperCase();
                        alert(`Giriş Başarılı! Rolünüz: ${data.rol || 'Belirsiz'}`);
                    } else {
                        alert("Hata: Bilgiler uyuşmuyor!");
                    }
                } catch (e) {
                    alert("Backend sunucusuna bağlanılamadı! (localhost:5000)");
                }
            },

            // 2. DUYURU SİSTEMİ
            fetchDuyurular: async () => {
                const apId = 1; // Örnek olarak 1 nolu apartman
                const res = await fetch(`${API_BASE}/duyurular/${apId}`);
                const data = await res.json();
                const tbody = document.getElementById('duyuru-table');
                tbody.innerHTML = data.map(d => `<tr><td>#${d.apartman_id}</td><td>${d.icerik}</td></tr>`).join('');
            },

            saveDuyuru: async () => {
                const apartman_id = document.getElementById('apDuyuruId').value;
                const icerik = document.getElementById('txtDuyuru').value;

                const res = await fetch(`${API_BASE}/duyurular`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ icerik, apartman_id: parseInt(apartman_id) })
                });

                if(res.ok) {
                    alert("Duyuru yayınlandı!");
                    core.fetchDuyurular();
                }
            },

            // 3. AİDAT SİSTEMİ
            fetchAidat: async () => {
                const daireId = document.getElementById('daireIdSorgu').value;
                if(!daireId) return alert("Daire ID giriniz");
                
                const res = await fetch(`${API_BASE}/aidat/${daireId}`);
                const data = await res.json();
                const tbody = document.getElementById('aidat-table');
                // Backend'den gelen veriye göre (tutar, durum vb.) maplenir
                tbody.innerHTML = data.map(a => `<tr><td>Daire ${daireId}</td><td>${a.tutar || '0'} ₺</td><td><span class="badge warning">Borçlu</span></td></tr>`).join('');
            },

            calculateAidat: async () => {
                const res = await fetch(`${API_BASE}/aidat/hesapla`, { method: 'POST' });
                if(res.ok) alert("SQL Prosedürü tetiklendi: Aidatlar hesaplandı!");
            },

            // 4. ARIZA SİSTEMİ
            fetchArizalar: async () => {
                const res = await fetch(`${API_BASE}/ariza`);
                const data = await res.json();
                const tbody = document.getElementById('issue-table');
                tbody.innerHTML = data.map(i => `<tr><td>Daire ${i.daire_id}</td><td>${i.aciklama}</td></tr>`).join('');
            },

            saveAriza: async () => {
                const daire_id = document.getElementById('daireArizaId').value;
                const aciklama = document.getElementById('txtAriza').value;

                const res = await fetch(`${API_BASE}/ariza`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ daire_id: parseInt(daire_id), aciklama })
                });

                if(res.ok) {
                    alert("Arıza bildirildi!");
                    core.fetchArizalar();
                }
            },

            // UI YÖNETİMİ
            switchTab: (id, el) => {
                document.querySelectorAll('.view-section').forEach(s => s.classList.remove('active'));
                document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
                document.getElementById(id).classList.add('active');
                el.classList.add('active');
                document.getElementById('view-title').innerText = el.innerText.substring(3);
            },
            toggleUserMenu: () => document.getElementById('userMenu').classList.toggle('active'),
            logout: () => location.reload()
        };

        // Sayfa dışına tıklandığında menü kapatma
        window.onclick = (e) => {
            if (!e.target.closest('.user-profile')) {
                document.getElementById('userMenu').classList.remove('active');
            }
        };
    </script>
</body>
</html>
